# Copy to .env.local (git-ignored) and point at your local Google Drive sync folder.
# Windows example (Google Drive for desktop):
DRIVE_ROOT=G:\My Drive
# The existing Web Deva site project, for its /public/shots screenshots
WEB_DEVA_ROOT=C:\Users\kmulk\web-deva-site
# Optional: a specific ffmpeg binary (otherwise the bundled ffmpeg-static is used)
# FFMPEG_PATH=
# Set to true once Helvetica Now Display web files are in public/fonts and the license allows web use
VITE_HELVETICA_NOW=false
