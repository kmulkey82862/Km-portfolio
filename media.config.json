{
  "$comment": "Copy to media.config.json, then run `npm run import-media`. Set DRIVE_ROOT in .env.local (e.g. DRIVE_ROOT=G:\\My Drive). Filenames below follow the handoff notes; adjust any that differ on disk. Folder entries import every match as <id>-1, <id>-2, ...",
  "roots": {
    "drive": "${DRIVE_ROOT}",
    "portfolio": "${DRIVE_ROOT}/Portfolio/Katelyn Mulkey Portfolio",
    "webdeva": "${WEB_DEVA_ROOT}",
    "adnet": "${ADNET_PAGES_DIR}"
  },
  "items": [
    { "id": "site-matt-chapin", "src": "webdeva:public/shots/matt-chapin.png", "alt": "Matt Chapin Music website" },
    { "id": "site-lighthouse", "src": "webdeva:public/shots/lighthouse.png", "alt": "Lighthouse Strategy Group website" },
    { "id": "site-3d-world", "src": "media-src/katelyns-world.jpg", "alt": "Katelyn’s World, a WebGL New Orleans sunset scene" },
    { "id": "site-adnet-2027", "src": "media-src/adnet-2027.jpg", "alt": "AdNet 2027 Conference website banner" },
    {"id": "adnet-2027", "src": "adnet:AdNet-2027.html", "alt": "AdNet 2027 conference website: home", "rewrite": [["/page/conference-2027(-[a-z]+)?", "adnet-2027$1.html"]]},
    {"id": "adnet-2027-agenda", "src": "adnet:AdNet-2027-Agenda.html", "alt": "AdNet 2027 conference website: agenda", "rewrite": [["/page/conference-2027(-[a-z]+)?", "adnet-2027$1.html"]]},
    {"id": "adnet-2027-sessions", "src": "adnet:AdNet-2027-Sessions.html", "alt": "AdNet 2027 conference website: call for sessions", "rewrite": [["/page/conference-2027(-[a-z]+)?", "adnet-2027$1.html"]]},
    {"id": "adnet-2027-hotel", "src": "adnet:AdNet-2027-Hotel.html", "alt": "AdNet 2027 conference website: hotel & travel", "rewrite": [["/page/conference-2027(-[a-z]+)?", "adnet-2027$1.html"]]},
    {"id": "adnet-2027-registration", "src": "adnet:AdNet-2027-Registration.html", "alt": "AdNet 2027 conference website: registration", "rewrite": [["/page/conference-2027(-[a-z]+)?", "adnet-2027$1.html"]]},
    {"id": "adnet-2027-sponsorship", "src": "adnet:AdNet-2027-Sponsorship.html", "alt": "AdNet 2027 conference website: sponsorship", "rewrite": [["/page/conference-2027(-[a-z]+)?", "adnet-2027$1.html"]]},
    {"id": "adnet-2027-sponsors", "src": "adnet:AdNet-2027-Sponsors.html", "alt": "AdNet 2027 conference website: sponsors", "rewrite": [["/page/conference-2027(-[a-z]+)?", "adnet-2027$1.html"]]},
    {"id": "adnet-2027-faq", "src": "adnet:AdNet-2027-FAQ-v2.html", "alt": "AdNet 2027 conference website: FAQ", "rewrite": [["/page/conference-2027(-[a-z]+)?", "adnet-2027$1.html"]]},
    { "id": "site-cdc", "src": "webdeva:public/shots/acdc.png", "alt": "American Chronic Disease Convention website" },
    { "id": "fimcon-archive", "src": "webdeva:public/shots/fimcon.png", "alt": "FIMCON 2026 session archive with searchable recordings" },

    { "id": "hnoc", "folder": "portfolio:Historic New Orleans Collection", "match": "^\\d+\\.png$", "limit": 6, "alt": "Yet She Is Advancing design" },
    {
      "id": "hnoc-video",
      "src": "portfolio:Historic New Orleans Collection/historic new orleans collection yet she is advancing video promo.mp4",
      "alt": "Yet She Is Advancing video promo",
      "loop": { "start": 0, "duration": 8 }
    },

    {
      "id": "comeaux-gotta-geaux",
      "src": "drive:Portfolio/KM - AI Creative Portfolio/COMEAUX - Gotta Geaux Promo AI Editor & Canva Template.mp4",
      "alt": "Gotta Geaux AI-edited video promo",
      "loop": { "start": 0, "duration": 8 }
    },
    { "id": "comeaux-infographic", "folder": "portfolio:Comeaux Furniture/Comeaux Infographics", "match": "\\.(png|jpe?g)$", "limit": 3, "alt": "Comeaux infographic" },
    { "id": "comeaux-social", "folder": "portfolio:Comeaux Furniture/Comeaux Social Media", "match": "\\.(png|jpe?g)$", "limit": 3, "alt": "Comeaux social post" },
    { "id": "comeaux-email", "folder": "portfolio:Comeaux Furniture/Comeaux Website, Email, and branded Assets", "match": "\\.(png|jpe?g)$", "limit": 3, "alt": "Comeaux email design" },

    { "id": "jazzfest-1", "src": "portfolio:Music promo design :: misc/Jazz Fest Margot Manning social promo 1.mp4", "alt": "Jazz Fest social promo", "loop": true },
    { "id": "jazzfest-2", "src": "portfolio:Music promo design :: misc/Jazz Fest Margot Manning social promo 2.mp4", "alt": "Jazz Fest social promo", "loop": true },
    {
      "id": "gesso-promo",
      "src": "portfolio:Music promo design :: misc/gesso promo.mp4",
      "alt": "Gesso promo",
      "loop": { "start": 2, "duration": 8 },
      "full": ""
    },
    { "id": "busted-on-bourbon", "src": "portfolio:Music promo design :: misc/busted on bourbon instagram promo.jpg", "alt": "Busted on Bourbon Instagram promo" },

    { "id": "smo-social", "folder": "portfolio:Sewing Machine Outlet/instagram posts & stories", "match": "\\.(png|jpe?g)$", "limit": 4, "alt": "Sewing Machine Outlet Instagram post" },
    { "id": "smo-email", "folder": "portfolio:Sewing Machine Outlet/email graphics", "match": "\\.(png|jpe?g)$", "limit": 3, "alt": "Sewing Machine Outlet email graphic" },

    { "id": "cura", "folder": "portfolio:Cura OS", "match": "\\.(png|jpe?g|heic)$", "limit": 4, "alt": "Cura OS brand work" }
  ]
}
